desc:Parametric EQ
slider1:1000<20,20000,1>Frequency (Hz)
slider2:0< -12,12,0.1>Gain (dB)
slider3:1<0.1,10,0.1>Bandwidth

@init
x1 = 0; x2 = 0;
y1 = 0; y2 = 0;

@slider
A = 10^(slider2/40);
w0 = 2 * $pi * slider1 / srate;
alpha = sin(w0) / (2 * slider3);

@sample
b0 = 1 + alpha * A;
b1 = -2 * cos(w0);
b2 = 1 - alpha * A;
a0 = 1 + alpha / A;
a1 = -2 * cos(w0);
a2 = 1 - alpha / A;

x0 = spl0;
spl0 = (b0/a0)*x0 + (b1/a0)*x1 + (b2/a0)*x2 - (a1/a0)*y1 - (a2/a0)*y2;
x2 = x1; x1 = x0;
y2 = y1; y1 = spl0;
spl1 = spl0;
