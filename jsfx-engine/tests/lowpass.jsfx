desc:Simple Lowpass Filter
slider1:1000<20,20000,1>Cutoff (Hz)
slider2:0.7<0.01,1,0.01>Resonance

@init
freq = 1000;
q = 0.7;

@slider
freq = slider1;
q = slider2;

@sample
// 一阶低通滤波器
k = exp(-2 * $pi * freq / srate);
spl0 = spl0 * (1-k) + _lp0 * k;
_lp0 = spl0;
spl1 = spl1 * (1-k) + _lp1 * k;
_lp1 = spl1;
