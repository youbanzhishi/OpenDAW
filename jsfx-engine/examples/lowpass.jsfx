desc:Simple Lowpass Filter
tags:filter eq utility
slider1:100<20,20000,1>Cutoff (Hz)
slider2:0.7<0.1,1,0.01>Q

@init
  // 状态变量 (biquad filter)
  x1 = 0;
  x2 = 0;
  y1 = 0;
  y2 = 0;

@slider
  // 计算低通滤波器系数
  omega = 2 * $pi * slider1 / srate;
  sin_omega = sin(omega);
  cos_omega = cos(omega);
  alpha = sin_omega / (2 * slider2);
  
  // b0, b1, b2, a1, a2 系数计算
  b0 = (1 - cos_omega) / 2;
  b1 = 1 - cos_omega;
  b2 = (1 - cos_omega) / 2;
  a0 = 1 + alpha;
  a1 = -2 * cos_omega;
  a2 = 1 - alpha;

@sample
  // Direct Form I biquad filter
  // 输入
  x0 = spl0;
  // 输出
  y0 = (b0/a0) * x0 + (b1/a0) * x1 + (b2/a0) * x2 - (a1/a0) * y1 - (a2/a0) * y2;
  
  // 右声道同样处理
  x0_r = spl1;
  y0_r = (b0/a0) * x0_r + (b1/a0) * x1 + (b2/a0) * x2 - (a1/a0) * y1 - (a2/a0) * y2;
  
  // 更新状态
  x2 = x1;
  x1 = spl0;
  y2 = y1;
  y1 = y0;
  
  // 输出
  spl0 = y0;
  spl1 = y0_r;
