# VCMix Docker Compose Environment Variables
# Copy this file to .env and customize for your deployment.

# ── Profile ──────────────────────────────────────────────────────────────
# core: Lightweight mode (~300MB RAM), no AI/collab/visualization endpoints
# full: All features including AI transcription, demucs, collaboration
VCMIX_PROFILE=core

# ── Network ──────────────────────────────────────────────────────────────
# Port to expose on the host
VCMIX_PORT=8000

# ── Resource Limits (for 2-core 1GB servers) ─────────────────────────────
# Memory limit for the container (leave ~512MB for OS + other services)
VCMIX_MEMORY_LIMIT=512M

# CPU limit (1.0 = 1 core)
VCMIX_CPU_LIMIT=1.0

# ── Data Paths ───────────────────────────────────────────────────────────
# Host directories for project files and render output
VCMIX_PROJECTS_DIR=./projects
VCMIX_OUTPUT_DIR=./output

# ── Logging ──────────────────────────────────────────────────────────────
# Log level: debug, info, warning, error
VCMIX_LOG_LEVEL=info
