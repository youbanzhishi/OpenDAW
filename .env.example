# ============================================================
# VCMix 环境变量配置
# ============================================================
# 使用方法：复制本文件为 .env，然后按需修改
#   cp .env.example .env
# ============================================================

# ── 部署模式 ──────────────────────────────────────────────
# 预构建镜像标签（方案B，推荐）
# latest: 最新版  |  v0.22.2: 指定版本
# 镜像地址：ghcr.io/youbanzhishi/vcmix:{profile}-{tag}
# 例：core-latest / full-latest / core-v0.22.2 / full-v0.22.2
VCMIX_IMAGE_TAG=latest

# ── 运行模式 ──────────────────────────────────────────────
# core: 轻量模式(~300MB运行内存)，无AI/协作/可视化端点，1G服务器推荐
# full: 完整模式，包含AI转录/Demucs音源分离/协作/可视化，需4G+内存
VCMIX_PROFILE=core

# ── 网络端口 ──────────────────────────────────────────────
# 对外暴露的端口，改成你想要的（不要和已有服务冲突）
VCMIX_PORT=8000

# ── 版本控制（仅自建方案需要，预构建方案忽略）──────────────
# 以下变量仅在 docker compose up -d --build 时生效
# OpenDAW源码版本（tag），构建时自动从GitHub下载
OPENDAW_VERSION=v0.22.2
# AudioFX CLI插件版本（tag），构建时自动从GitHub Release下载
AUDIOFX_RELEASE_VERSION=v2.8.0

# ── 资源限制（2核1GB服务器推荐值）──────────────────────────
# 容器内存上限，1G服务器建议512M（留一半给系统）
# 4G+服务器可以改成 2G
VCMIX_MEMORY_LIMIT=512M

# 容器CPU核数限制，1.0 = 1核
VCMIX_CPU_LIMIT=1.0

# ── 数据目录 ──────────────────────────────────────────────
# 宿主机上的目录，存放工程文件和渲染输出
# 支持相对路径(./)和绝对路径(/data/vcmix/)
VCMIX_PROJECTS_DIR=./projects
VCMIX_OUTPUT_DIR=./output

# ── 日志级别 ──────────────────────────────────────────────
# debug: 最详细（调试用）
# info:  正常（推荐）
# warning: 只显示警告和错误
# error: 只显示错误
VCMIX_LOG_LEVEL=info
